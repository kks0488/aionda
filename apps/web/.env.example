# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Newsletter (optional)
# Buttondown handle (e.g. "aionda" for https://buttondown.email/aionda)
NEXT_PUBLIC_NEWSLETTER_BUTTONDOWN_HANDLE=

# Google Search Console verification (optional - can also use DNS or HTML file)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Admin UI
ADMIN_ENABLED=false
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,::1
NEXTAUTH_SECRET=replace_with_long_random_secret
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_USERS=your-github-login
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_PUBLISH_ENABLED=false
